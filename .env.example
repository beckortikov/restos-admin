# Bcrypt-hash пароля админа. Сгенерировать:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=$2a$10$replace-me

# >=32 байт случайной строки для подписи session cookie.
#   openssl rand -base64 48
SESSION_SECRET=replace-with-random-48-chars-or-more

# Ed25519 PRIVATE key (base64 std) — секретный, выписывает токены.
# Public key уже вшит в restos-server бинарь.
# Получить новую пару:
#   cd ../restos-v4/server && go run ./cmd/license-gen keypair
# PRIVATE_KEY=... → сюда. PUBLIC_KEY=... → в Go LICENSE_PUBLIC_KEY env.
LICENSE_PRIVATE_KEY=replace-with-base64

# Neon Postgres (history/audit выданных лицензий).
# https://console.neon.tech → Project → Dashboard → Connection string (pooled).
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
